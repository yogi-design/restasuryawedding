# MySQL connection for the wedding app
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=restasurya
PORT=4000
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Session signing key; generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# One-time initial account if admin_users is empty. Remove both after API startup.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Frontend API endpoint
VITE_API_URL=http://localhost:4000

# Optional legacy Supabase config
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
